# =========================================================================
# NOVATAS 2K26 — Environment Variables Configuration
# =========================================================================
# Copy this file to .env.local for local development.
# In Vercel: Add these variables under Project Settings -> Environment Variables.

# Supabase PostgreSQL Database API
# Create a free project at https://supabase.com
# Find these under Project Settings -> API in your Supabase dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional: Initial admin bootstrap password hash override (defaults to secure hash)
# VITE_ADMIN_BOOTSTRAP_HASH=$2b$10$l0JrBlXrmnV3AjV1E2ejtu2F63VgKoUsii2crq9WRYkS/AC9Z.7mW
